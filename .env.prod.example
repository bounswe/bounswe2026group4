DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=change-me-to-a-50-char-random-string
ALLOWED_HOSTS=yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com
DB_NAME=historystorymap
DB_USER=dbuser
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root
DB_HOST=127.0.0.1
DB_PORT=3306
MEDIA_ROOT=/app/media
# Passed as a Docker build arg to nginx — the React bundle will call this URL.
VITE_API_URL=https://yourdomain.com/api
# Injected into the nginx config at container startup via envsubst.
NGINX_HOST=yourdomain.com
# Optional: set to your Sentry DSN to enable error tracking.
SENTRY_DSN=
# Email delivery via Resend (https://resend.com)
# 1. Create a Resend account and verify your sending domain.
# 2. Generate an API key with sending permissions.
# 3. Set EMAIL_HOST_PASSWORD to the API key (starts with re_...)
# 4. Set DEFAULT_FROM_EMAIL to an address on your verified domain.
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=re_your_api_key_here
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
DEFAULT_FROM_EMAIL=Local History Story Map <noreply@yourdomain.com>
NOMINATIM_CONTACT_EMAIL=your-email@yourdomain.com
